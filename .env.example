# ════════════════════════════════════════════════════════════════════════════
# CONFIGURACIÓN DEL PROYECTO RAG - QDRANT + VISIÓN + FRONTEND
# ════════════════════════════════════════════════════════════════════════════

# Copiar este archivo a .env y ajustar los valores según el entorno.

# ── Qdrant ──────────────────────────────────────────────────────────────
# URL de Qdrant (Docker o cloud). Dejar vacío para almacenamiento local en disco.
QDRANT_URL=
# Obligatoria si usas docker-compose o un Qdrant remoto. Generar con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# En modo local sin QDRANT_URL puede quedar vacía.
QDRANT_API_KEY=

# Nombre de la colección vectorial (debe coincidir con las que existen en disco)
QDRANT_COLLECTION_NAME=sublitex_fashion_v1

# Timeouts de conexión (segundos)
QDRANT_TIMEOUT=30
QDRANT_GRPC_TIMEOUT=10
QDRANT_SNAPSHOT_PATH=

# ── Rutas de datos ──────────────────────────────────────────────────────
CATALOG_PATH=./data/images_normalized

# Carpeta donde Qdrant guarda sus datos en modo local
QDRANT_DATA_PATH=./qdrant_data

# Snapshot local opcional para restaurar si la colección aún no existe.
# En Docker, la ruta debe estar dentro del volumen compartido de Qdrant:
# QDRANT_SNAPSHOT_PATH=file:///qdrant/storage/snapshots/coleccion/archivo.snapshot

# ── API ─────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── Seguridad API (obligatorio) ─────────────────────────────────────────
# Generar claves largas y aleatorias, por ejemplo:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Usar claves DISTINTAS para cliente y administrador.
# Si faltan, los endpoints protegidos responden 503 (fail-closed).
API_CLIENT_KEY=
# Opcional: claves adicionales por cliente, formato "nombre:clave,otro:clave".
# API_CLIENT_KEY sigue funcionando como cliente "default".
API_CLIENT_KEYS=
API_ADMIN_KEY=

# Orígenes permitidos por CORS, separados por comas. Nunca usar "*".
# En producción usa SOLO el dominio real, por ejemplo:
#   CORS_ORIGINS=https://rag.tudominio.com
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

SITE_ADDRESS=localhost

# ── Web UI (Streamlit) ──────────────────────────────────────────────────
UI_HOST=127.0.0.1
UI_PORT=7860

# ── Frontend (Next.js) ──────────────────────────────────────────────────
# El frontend ya NO recibe una URL pública de la API ni claves NEXT_PUBLIC_*.
# Usa un proxy server-side (/api/search, /api/health). Para desarrollo local
# copiar frontend/.env.example a frontend/.env.local. En Docker, la URL
# interna y la API_CLIENT_KEY se configuran en docker-compose.yml.

# ── Logs ────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Alertas (scripts/health_alert.py) ───────────────────────────────────
# El script consulta /health y notifica SOLO cuando cambia entre OK y fallo.
# Si ALERT_WEBHOOK_URL queda vacía, el aviso se escribe en stdout (cron/log).
# Formatos: generic | discord | slack | telegram.
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_FORMAT=generic
ALERT_WEBHOOK_TIMEOUT=10

# Solo para ALERT_WEBHOOK_FORMAT=telegram (no se registran en logs).
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=

# Endpoint de salud a vigilar. Usar la URL interna desde el host
# (uvicorn) o la pública detrás del proxy (https://dominio/api/health).
HEALTH_URL=http://127.0.0.1:8000/health
HEALTH_TIMEOUT=10

# Umbrales opcionales; 0 desactiva cada comprobación.
# Minimos del catálogo cargado y latencia máxima del propio /health.
ALERT_MIN_PRODUCTS=0
ALERT_MIN_EMBEDDINGS=0
ALERT_MAX_HEALTH_MS=0

# Readiness de Qdrant (vacío = no comprobar). Interno: http://qdrant:6333/readyz
ALERT_QDRANT_READYZ_URL=

# Prueba sintética de búsqueda (vacío = no comprobar). Consume CPU real,
# por eso se ejecuta solo si se configura. ALERT_API_KEY = clave de cliente.
ALERT_SEARCH_URL=
ALERT_SEARCH_IMAGE=
ALERT_SEARCH_MODELO=clip
ALERT_API_KEY=
ALERT_MAX_SEARCH_MS=0
# Segundos de espera para la búsqueda sintética (fusion en CPU puede tardar).
ALERT_SEARCH_TIMEOUT=120

# Archivo donde se recuerda el último estado para no repetir avisos.
ALERT_STATE_FILE=.alert_state.json
