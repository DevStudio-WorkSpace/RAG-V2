# Dockerfile para la API FastAPI (RAG Sublitex)
FROM python:3.11-slim

WORKDIR /app

# Dependencias del sistema necesarias para OpenCV y Pillow
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 \
    libglib2.0-0 \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Fijar NumPy 1.x antes de cualquier otra librería para evitar conflicto con OpenCV y PyTorch
RUN pip install --no-cache-dir "numpy>=1.24.0,<2.0.0"

# Instalar PyTorch CPU específico
RUN pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu torch==2.14.1+cpu torchvision==0.29.1+cpu

# Instalar resto de dependencias
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copiar código de backend y scripts
COPY api/ ./api/
COPY core/ ./core/
COPY scripts/ ./scripts/
COPY .env* ./

# Seguridad: Crear usuario no-root (con home para caché de Hugging Face)
RUN useradd -m -u 10001 appuser && \
    chown -R appuser:appuser /app /home/appuser
USER appuser

# Caché de modelos dentro del home del usuario (voluble con volumen)
ENV HF_HOME=/home/appuser/.cache/huggingface

EXPOSE 8000

CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
