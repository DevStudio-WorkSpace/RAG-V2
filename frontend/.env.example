# Copiar a frontend/.env.local para desarrollo local.
# Estas variables son SOLO del servidor de Next.js: no usar NEXT_PUBLIC_*.
#
# URL interna de FastAPI. En Docker se define como http://api:8000.
API_URL=http://localhost:8000
#
# Debe coincidir con API_CLIENT_KEY del backend.
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
API_CLIENT_KEY=
