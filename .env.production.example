# Plantilla de producción. Copiar a .env en el VPS y reemplazar todos los
# valores REEMPLAZAR_* con valores reales. No subir .env ni compartir secretos.

# Dominio DNS apuntando al VPS; Caddy obtiene TLS automáticamente.
SITE_ADDRESS=TU_DOMINIO_REAL
CORS_ORIGINS=https://TU_DOMINIO_REAL

# Generar claves distintas con:
# python3 -c "import secrets; print(secrets.token_urlsafe(48))"
API_CLIENT_KEY=REEMPLAZAR_POR_CLAVE_ALEATORIA_DE_CLIENTE
API_CLIENT_KEYS=
API_ADMIN_KEY=REEMPLAZAR_POR_CLAVE_ALEATORIA_DE_ADMIN
QDRANT_API_KEY=REEMPLAZAR_POR_CLAVE_ALEATORIA_DE_QDRANT

# El script de despliegue asigna el SHA del commit a las imágenes.
APP_IMAGE_TAG=local
QDRANT_SNAPSHOT_PATH=

# La UI usa rutas server-side; este valor es solo el argumento de build legado
# del Compose y no debe contener secretos.
NEXT_PUBLIC_API_URL=/backend

# Alertas opcionales. Mantener vacía hasta configurar un destino aprobado.
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_FORMAT=generic
ALERT_WEBHOOK_TIMEOUT=10
# Solo para Telegram; nunca registrar estos valores.
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=

# Healthcheck del servicio desde el host.
HEALTH_URL=https://TU_DOMINIO_REAL/api/health
HEALTH_TIMEOUT=10
ALERT_MIN_PRODUCTS=0
ALERT_MIN_EMBEDDINGS=0
ALERT_MAX_HEALTH_MS=0
# Dejar vacío salvo que el proceso de alertas resuelva qdrant en su red.
ALERT_QDRANT_READYZ_URL=
# Búsqueda sintética opcional; consume CPU y requiere una imagen de prueba local.
ALERT_SEARCH_URL=
ALERT_SEARCH_IMAGE=
ALERT_SEARCH_MODELO=clip
ALERT_API_KEY=
ALERT_MAX_SEARCH_MS=0
ALERT_SEARCH_TIMEOUT=120
ALERT_STATE_FILE=.alert_state.json
